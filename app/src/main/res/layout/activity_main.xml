<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- پنل شناور بالا: جستجوی صوتی و انتخاب وسیله نقلیه -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#EE161B22"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- نوار جستجو و دکمه میکروفون -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoiceSearch"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:backgroundTint="#00C853"
                android:text="🎤"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#21262D"
                android:hint="نام مقصد را بگویید یا بنویسید..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B949E"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSearchGo"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:backgroundTint="#1F6FEB"
                android:text="🔍"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- نوار انتخاب نوع وسیله نقلیه -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeCar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#1F6FEB"
                    android:text="🚗 خودرو"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnModeMoto"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#21262D"
                    android:text="🏍️ موتور"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnModeBike"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#21262D"
                    android:text="🚲 دوچرخه"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnModeWalk"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#21262D"
                    android:text="🚶 پیاده"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnModeTransit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#21262D"
                    android:text="🚌 عمومی"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- پنل شناور پایین: اطلاعات مسیر و ابزارهای کمکی -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="#EE161B22"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده | دکمه 🎤 را بزنید یا روی نقشه لمس کنید"
            android:textColor="#58A6FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="مقصد را انتخاب کنید (ایران و کل جهان)"
            android:textColor="#00FF9C"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLang"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#30363D"
                android:text="🌐 فارسی"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHud"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#30363D"
                android:text="🚘 HUD"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMyLoc"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#238636"
                android:text="📍 مکان من"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
