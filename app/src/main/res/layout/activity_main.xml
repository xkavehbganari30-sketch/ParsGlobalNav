<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- پنل بالای صفحه: دستور صوتی و وضعیت آنلاین/آفلاین -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="#E6161B22"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وضعیت: آماده | برای مسیریابی روی نقشه لمس کنید"
            android:textColor="#58A6FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="مقصد را انتخاب کنید (اولویت ایران + کل جهان)"
            android:textColor="#00FF9C"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- پنل پایین: انتخاب زبان، حالت HUD و موقعیت مکانی -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="زبان: فارسی"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="حالت HUD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnMyLoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="موقعیت من"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
